// fine paragrafo

proc load_cell() { // loading soma and dendrites

	forall delete_section() // cancella le sezioni di precedenti modelli
	curr_mod = $s1
	load_file(1,curr_mod)
	
	box2 = new VBox(2)
	box2.intercept(1)
	sh = new Shape()
	box2.intercept(0)
	box2.map("Shape",500,25,350,350)

}

proc compl() { // completamento dei singoli neuroni (con i rispettivi steady-states)


	load_file(1,"2_complete_cell.hoc")
	
//  load save-states, utilizzando l'argomento della procedura

//	sprint(filename,"state%g.dat",$1)
//	f = new File(filename)
//	svstate.fread(f)
}

// controlli

celsius=37

{
xpanel("RunControl", 0)
v_init = -70
xvalue("Init","v_init", 1,"stdinit()", 1, 1 )
xbutton("Init & Run","run()")
xbutton("Stop","stoprun=1")
runStopAt = 5
xvalue("Continue til","runStopAt", 1,"{continuerun(runStopAt) stoprun=1}", 1, 1 )
runStopIn = 1
xvalue("Continue for","runStopIn", 1,"{continuerun(t + runStopIn) stoprun=1}", 1, 1 )
xbutton("Single Step","steprun()")
t = 1
xvalue("t","t", 2 )
tstop = 20
xvalue("Tstop","tstop", 1,"tstop_changed()", 0, 1 )
dt = 0.025
xvalue("dt","dt", 1,"setdt()", 0, 1 )
steps_per_ms = 40
xvalue("Points plotted/ms","steps_per_ms", 1,"setdt()", 0, 1 )
screen_update_invl = 0.2
xvalue("Scrn update invl","screen_update_invl", 1,"", 0, 1 )
xcheckbox("Quiet",&stdrun_quiet,"")
realtime = 0
xvalue("Real Time","realtime", 0,"", 0, 1 )
xpanel(45,80)
}


// auto-load first morphology (same filenames as the first button)

// (optional) keep a tiny info window so you see what was loaded
box1.intercept(1)
xpanel("")
xlabel("Auto-loaded:")
xlabel("MN1.hoc")
xpanel(400,25)
box1.intercept(0)
box1.map("choose a neuron!",300,25,200,120)

// do the same calls your first button did
load_cell("MN1.hoc")
compl(1)

