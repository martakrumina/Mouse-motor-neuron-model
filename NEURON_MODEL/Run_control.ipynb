   "outputs": [],
   "source": [
    "sections = h.allsec()\n",
    "EFsections = []\n",
    "for sec in sections:\n",
    "    if sec == h.AH:\n",
    "        break\n",
    "    else:\n",
    "        EFsections.append(sec)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7f97ec14-33d4-4c9b-bfec-9d8e57552d20",
   "metadata": {},
   "source": [
    "Here you can change the dirrection of the field - sec.y3d for the y axis and sec.x3d for the x axis:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "ddb3511d-afd8-4d7d-8d2f-2d6f3d7266f8",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = []\n",
    "for sec in EFsections:\n",
    "    sec_x_values = [sec.y3d(i) for i in range(sec.n3d())]\n",
    "    sec_x_center = sum(sec_x_values) / len(sec_x_values)\n",
    "    x.append(sec_x_center)"
   ]
  },
  {
