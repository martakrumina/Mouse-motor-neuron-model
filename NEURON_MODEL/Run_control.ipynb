   "outputs": [],
   "source": [
    "field_strength = 0.002\n",
    "\n",
    "i=0\n",
    "for sec in EFsections:\n",
    "    sec.e_extracellular = field_strength * x[i] \n",
    "    i = i+1\n"
   ]
