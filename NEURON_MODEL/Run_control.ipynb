   "source": [
    "Select sections for the extracellular mechanism to include the soma and dendritic tree, but not the axon:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "c789c9fe-86f0-4f3b-bbff-4b651093e1b0",
